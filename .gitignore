node_modules/
dist/
sockitt.zip
# Glob, not the bare name: a file-sync daemon watching this folder turns each
# rebuild's delete-and-recreate into conflict copies ("sockitt 2.crx", …).
sockitt*.crx
.crx-tmp/
.shots-tmp/
# gen-store-shots.mjs stages here and deletes it again, so this should never
# match anything — but the same sync daemon forks the staging tree mid-run into
# "background 3.js", "img 4/", … and those outlive the cleanup. Glob, and no
# trailing slash: the conflict copies are both files and directories.
.store-shots-tmp*
*.pem
.DS_Store
