{
  "name": "sockitt",
  "version": "1.6.1",
  "private": true,
  "description": "Sockitt — a fast, modern SOCKS5 proxy switcher for Chromium browsers",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "typecheck": "tsc --noEmit",
