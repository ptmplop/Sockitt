{
  "name": "sockitt",
  "version": "1.16.4",
  "private": true,
  "description": "Sockitt \u2014 a fast, modern proxy switcher for Chromium browsers (SOCKS5, SOCKS4, HTTP, HTTPS)",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "zip": "node build.mjs --zip",
    "crx": "node build.mjs --crx",
    "test": "node --test",
    "shots": "node build.mjs && node scripts/gen-store-shots.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "esbuild": "^0.25.5",
    "flag-icons": "^7.5.0",
    "typescript": "^5.8.3"
  }
}
